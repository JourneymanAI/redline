# ---------------------------------------------------------------------------
# Redline — .gitignore (Next.js project)
# ---------------------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo

# Testing / coverage
/coverage

# ---------------------------------------------------------------------------
# Environment & secrets — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Generic credential / key material (defense in depth)
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.asc
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*_rsa
*_dsa
*_ecdsa
*_ed25519

# Cloud / service-account credentials
.aws/
.gcp/
.azure/
gcp-*.json
service-account*.json
serviceAccount*.json
credentials.json
client_secret*.json
*-credentials.json

# Auth / token caches
.npmrc
.netrc
.pypirc
.terraform/
*.tfstate
*.tfstate.*
.vault-token

# ---------------------------------------------------------------------------
# Tooling / platform
# ---------------------------------------------------------------------------
.vercel
.turbo
.cache

# Logs & debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
