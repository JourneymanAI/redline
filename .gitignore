# ---------------------------------------------------------------------------
# Redline — .gitignore (Next.js project)
# ---------------------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo

# Testing / coverage
/coverage

# ---------------------------------------------------------------------------
# Environment & secrets — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Generic credential / key material (defense in depth)
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.asc
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*_rsa
*_dsa
*_ecdsa
*_ed25519

# Cloud / service-account credentials
.aws/
.gcp/
.azure/
gcp-*.json
service-account*.json
serviceAccount*.json
credentials.json
client_secret*.json
*-credentials.json

# Auth / token caches
.npmrc
.netrc
.pypirc
.terraform/
*.tfstate
*.tfstate.*
.vault-token

# ---------------------------------------------------------------------------
# Tooling / platform
# ---------------------------------------------------------------------------
.vercel
.turbo
.cache

# Impeccable design-plugin process artifacts — regeneratable, not project record.
# DESIGN.md, its .impeccable/design.json sidecar, and .impeccable/surfaces/ ARE
# tracked on purpose: they're the durable design-system record, not ephemera.
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/review/

# Logs & debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local prompt / scratch inputs — not part of the project record
Claude_MD_Prompt.txt
Redline_First_Decision.txt
Redline-Grill_the_interview.txt

# Cohort session notes — contains other students' names and personal Vercel URLs
Redline_Build_Notes.txt

# Account recovery codes — never commit, keep in a password manager instead
Vercel-recovery-codes.txt

# Course / session materials — kept local (the distilled notes in docs/ are tracked)
Session 2 08282026 Harness and Brief.docx
Session 2 08282026 Harness and Brief.pdf
session-2-student-handbook.pdf
